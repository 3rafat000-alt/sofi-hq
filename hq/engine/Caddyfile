# ───────────────────────────────────────────────────────────────────────
# Default guard: any undefined host on port 80 → explicit 404
# (replaces the old wildcard and prevents disclosing content on random names)
# ───────────────────────────────────────────────────────────────────────
http://:80 {
	respond 404
}

# Active sites — one file per domain
import sites/*.caddy
