			root /home/es3dlll/Desktop/SOFI/projects/sakk/backend/public
		}

		file_server
		encode zstd gzip
	}

	# PayPal deep-link bridge (RCCF-03 · 2026-08-26) — mirror of the local variant;
	# returnUrl/cancelUrl use the public domain in production, so this block is
	# required for the sakk:// deep link to reach Laravel from the live site.
	handle /paypal/* {
		root * /home/es3dlll/Desktop/SOFI/projects/sakk/backend/public

		@notStatic {
			not file {
				try_files {path} /index.php?{query}
			}
		}
		rewrite @notStatic /index.php?{query}

		php_fastcgi unix//run/php/sakk.sock {
			root /home/es3dlll/Desktop/SOFI/projects/sakk/backend/public
		}

		file_server
		encode zstd gzip
	}

	# Independent partner portals (React SPA — /agent /merchant /company)
	redir /agent /agent/ permanent
	handle_path /agent/* {
		root * /home/es3dlll/Desktop/SOFI/projects/sakk/apps/portal/dist
		try_files {path} /index.html
		file_server
		encode zstd gzip
		header Cache-Control "no-cache, no-store, must-revalidate"
		import security_headers
	}

	redir /merchant /merchant/ permanent
	handle_path /merchant/* {
		root * /home/es3dlll/Desktop/SOFI/projects/sakk/apps/portal/dist
		try_files {path} /index.html
		file_server
		encode zstd gzip
		header Cache-Control "no-cache, no-store, must-revalidate"
		import security_headers
	}

	redir /company /company/ permanent
	handle_path /company/* {
		root * /home/es3dlll/Desktop/SOFI/projects/sakk/apps/portal/dist
		try_files {path} /index.html
		file_server
		encode zstd gzip
		header Cache-Control "no-cache, no-store, must-revalidate"
		import security_headers
	}

	# Portal (React SPA — /portal) — re-enabled 2026-08-26 (base '/portal/' · vite.config.js:7)
	redir /portal /portal/ permanent
	handle /portal/assets/* {
		uri strip_prefix /portal
		root * /home/es3dlll/Desktop/SOFI/projects/sakk/apps/portal/dist
		file_server
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
	}
	handle_path /portal/* {
		root * /home/es3dlll/Desktop/SOFI/projects/sakk/apps/portal/dist
		try_files {path} /index.html
		file_server
		encode zstd gzip
		header Cache-Control "no-cache, no-store, must-revalidate"
		import security_headers
	}
	handle /assets/* {
		root * /home/es3dlll/Desktop/SOFI/projects/sakk/apps/site/dist
		file_server
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		import security_headers
		import csp_sakk
	}

	handle {
		root * /home/es3dlll/Desktop/SOFI/projects/sakk/apps/site/dist
		try_files {path} /index.html
		file_server
		encode zstd gzip
		header Cache-Control "public, max-age=300"
		import security_headers
		import csp_sakk
