# [disabled 2026-08-25] the entire Tobacco Center system — its paths under projects/tobacco-center no longer exist
# The text below was moved verbatim from the pre-restructuring Caddyfile (the original is archived with its fingerprint)

# Production wrapper: /run/php/sofi.sock
(tobacco_store) {
	import tobacco_core /run/php/sofi.sock
}

# Demo wrapper (public domain): /run/php/sofi-demo.sock
(tobacco_store_demo) {
	import tobacco_core /run/php/sofi-demo.sock
}

# Core: serves /pos statically plus /api and the root through the socket passed as an argument
(tobacco_core) {
	handle_path /store/* {
		respond 404
	}

	handle_path /pos/* {
		root * /home/es3dlll/Desktop/SOFI/projects/tobacco-center/store/public/dist-fresh
		try_files {path} /index.html
		file_server
		encode zstd gzip
		header Cache-Control "no-cache, no-store, must-revalidate"
		import security_headers
	}

	redir /pos /pos/ permanent

	handle_path /wa/* {
		reverse_proxy localhost:3090
	}

	handle /api/* {
		root * /home/es3dlll/Desktop/SOFI/projects/tobacco-center/backend/public

		@notStatic {
			not file {
				try_files {path} /index.php?{query}
			}
		}
		rewrite @notStatic /index.php?{query}

		php_fastcgi unix//{args[0]} {
			root /home/es3dlll/Desktop/SOFI/projects/tobacco-center/backend/public
		}

		file_server
		encode zstd gzip
		import security_headers
	}

	handle {
		root * /home/es3dlll/Desktop/SOFI/projects/tobacco-center/store/public

		@php {
			path *.php
		}
		rewrite @php {path}
		php_fastcgi unix//{args[0]} {
			root /home/es3dlll/Desktop/SOFI/projects/tobacco-center/store/public
		}

		file_server
		encode zstd gzip
		header Cache-Control "public, max-age=300"
		import security_headers
	}
}

# Public over the internet — Catch-all (seller panel /admin blocked)
http://:80 {
	@public_admin {
		path_regexp public_admin ^/admin(/.*)?$
	}
	handle @public_admin {
		respond 404
	}

	import block_sensitive
	import tobacco_store
}

# Demo copy via the tunnel
http://tobacco.zanjour.com {
	@public_admin {
		path_regexp public_admin ^/admin(/.*)?$
	}
	handle @public_admin {
		respond 404
	}

	import block_sensitive
	import tobacco_store_demo
}

# Local
http://tobacco.local {
	import block_sensitive
	import tobacco_store
}

# Local — localhost directly
http://localhost {
	import block_sensitive
	import tobacco_store
}
